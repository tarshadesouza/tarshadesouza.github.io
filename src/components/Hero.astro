---
import { site, intro, social } from '../data/profile';
import { isTodo, inlineLinks } from '../lib/content';
import Dashboard from './Dashboard.astro';

/** Split the name so the surname can carry the accent italic. */
const [first, ...rest] = site.name.split(' ');
const surname = rest.join(' ');
---

<header class="hero" id="top">
  <div class="shell hero-layout">
   <div class="hero-intro">
    {/* Separators are drawn by CSS on each item after the first, so a dot can
        never be left stranded at the end of a wrapped line. */}
    <p class="hero-role" data-reveal>
      <span>{site.role}</span>
      {!isTodo(site.location) && <span>{site.location}</span>}
      {site.status && <span class="status">{site.status}</span>}
    </p>

    <h1 class="hero-name">
      <span data-reveal style="--reveal-delay:80ms" class="block">{first}</span>
      <span data-reveal style="--reveal-delay:180ms" class="block"><em>{surname}</em></span>
    </h1>

    {/* The one line someone reads if they read nothing else. */}
    {site.tagline && !isTodo(site.tagline) && (
      <p class="hero-tagline" data-reveal style="--reveal-delay:240ms">{site.tagline}</p>
    )}

    <div class="prose">
      {intro.slice(0, 1).map((paragraph, i) => (
        <p class="hero-lede" data-reveal style={`--reveal-delay:${340 + i * 90}ms`}>
          {inlineLinks(paragraph).map((part) =>
            typeof part === 'string' ? (
              part
            ) : (
              // Kept on one line: newlines here become whitespace inside the
              // anchor, and the underline then runs past the word.
              <a class="lede-link" href={part.href} target="_blank" rel="noopener">{part.label}</a>
            ),
          )}
        </p>
      ))}
    </div>

    <div class="hero-actions" data-stagger="80">
      <a class="btn btn-primary" href="#work" data-reveal>
        See the work
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      {/*
        On the first screen on purpose. Someone who wants to make contact
        shouldn't have to read the whole page to find out how — the footer is
        the wrong and only place for it.
      */}
      {!isTodo(social.email) && (
        <a class="btn" href={`mailto:${social.email}`} data-reveal>
          Email me
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      )}
      <a class="btn" href={`https://github.com/${social.github}`} data-reveal rel="me noopener" target="_blank">
        GitHub
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      {!isTodo(social.linkedin) && (
        <a class="btn" href={`https://www.linkedin.com/in/${social.linkedin}`} data-reveal rel="me noopener" target="_blank">
          LinkedIn
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      )}
    </div>
   </div>

   <div class="hero-dash" data-parallax="-0.04">
     <Dashboard limit={3} />
   </div>
  </div>
</header>

<style>
  .block {
    display: block;
  }

  .hero-role span + span::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--fg-faint);
  }

  .hero-role .status {
    color: var(--accent);
  }

  .hero-layout {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
    padding-block: 3rem;
  }

  /* Two columns only when there's genuinely room for both; below that the
     dashboard drops underneath the intro at full width. */
  @media (min-width: 68rem) {
    .hero-layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.7fr);
      padding-block: 4rem 3rem;
    }
  }

  .hero-dash {
    min-width: 0;
  }

  @media (min-width: 68rem) {
    .hero-lede {
      font-size: var(--step-0);
      max-width: 40ch;
    }
  }
</style>
