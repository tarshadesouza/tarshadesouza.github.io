---
import Dashboard from './Dashboard.astro';
import { site, intro, social } from '../data/profile';
import { isTodo } from '../lib/content';

/** Split the name so the surname can carry the accent italic. */
const [first, ...rest] = site.name.split(' ');
const surname = rest.join(' ');
---

<header class="hero" id="top">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true" data-parallax="0.18"></div>

  <div class="shell hero-layout">
   <div class="hero-intro">
    <p class="hero-role" data-reveal>
      <span>{site.role}</span>
      {!isTodo(site.location) && <span aria-hidden="true">·</span>}
      {!isTodo(site.location) && <span>{site.location}</span>}
      {site.status && <span aria-hidden="true">·</span>}
      {site.status && <span style="color:var(--accent)">{site.status}</span>}
    </p>

    <h1 class="hero-name">
      <span data-reveal style="--reveal-delay:80ms" class="block">{first}</span>
      <span data-reveal style="--reveal-delay:180ms" class="block"><em>{surname}</em></span>
    </h1>

    <div class="prose">
      {intro.map((paragraph, i) => (
        <p class="hero-lede" data-reveal style={`--reveal-delay:${280 + i * 90}ms`}>
          {paragraph}
        </p>
      ))}
    </div>

    <div class="hero-actions" data-stagger="80">
      <a class="btn btn-primary" href="#work" data-reveal>
        See the work
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn" href={`https://github.com/${social.github}`} data-reveal rel="me noopener" target="_blank">
        GitHub
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      {!isTodo(social.linkedin) && (
        <a class="btn" href={`https://www.linkedin.com/in/${social.linkedin}`} data-reveal rel="me noopener" target="_blank">
          LinkedIn
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      )}
    </div>
   </div>

   {/* Live GitHub state, on the first screen — the proof behind the words. */}
   <div class="hero-dash" data-parallax="-0.04">
     <Dashboard limit={3} />
   </div>
  </div>
</header>

<style>
  .block {
    display: block;
  }

  .hero-layout {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
    padding-block: 3rem;
  }

  /* Two columns only when there's genuinely room for both; below that the
     dashboard drops underneath the intro at full width. */
  @media (min-width: 68rem) {
    .hero-layout {
      grid-template-columns: minmax(0, 1.02fr) minmax(23rem, 0.98fr);
      padding-block: 0;
    }
  }

  .hero-dash {
    min-width: 0;
  }

  /* Sharing the screen with the dashboard, the name steps down a size so both
     fit above the fold. */
  @media (min-width: 68rem) {
    .hero-name {
      font-size: var(--step-4);
    }

    .hero-lede {
      font-size: var(--step-0);
      max-width: 40ch;
    }
  }
</style>
