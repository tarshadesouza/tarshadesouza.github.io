---
/**
 * The GitHub-style event timeline. Shared by the dashboard on the first screen
 * (a short preview) and the full activity section further down, so the two can
 * never drift apart.
 */
import EventIcon from './EventIcon.astro';
import { relativeTime, type ActivityItem } from '../lib/content';

interface Props {
  items: ActivityItem[];
  /** Adds a little more breathing room in the full-width section. */
  size?: 'compact' | 'roomy';
}

const { items, size = 'compact' } = Astro.props;
---

<ol class="timeline" data-size={size} data-stagger="60">
  {items.map((item) => (
    <li class="event" data-reveal>
      <span class="event-node" data-kind={item.kind}>
        <EventIcon kind={item.kind} />
      </span>

      <a class="event-body" href={item.url} target="_blank" rel="noopener">
        <span class="event-line">
          <span class="event-verb">{item.verb}</span>
          {item.number && <span class="event-num">#{item.number}</span>}
          {item.state && <span class="pill" data-state={item.state}>{item.state}</span>}
          {item.external && <span class="pill" data-state="external">contribution</span>}
        </span>

        {item.title && <span class="event-title">{item.title}</span>}

        <span class="event-meta">
          <span class="event-repo">{item.repo}</span>
          {item.branch && <span class="event-branch">{item.branch}</span>}
          <span class="event-when">{relativeTime(item.at)}</span>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .event {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    gap: 0.7rem;
    position: relative;
    padding-bottom: 0.9rem;
  }

  /* The rail that connects the nodes, exactly like a commit list. */
  .event::before {
    content: '';
    position: absolute;
    left: 0.8rem;
    top: 1.7rem;
    bottom: 0;
    width: 1px;
    background: var(--hairline-strong);
  }

  .event:last-child {
    padding-bottom: 0;
  }

  .event:last-child::before {
    display: none;
  }

  [data-size='roomy'] .event {
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1.1rem;
    padding-bottom: 1.6rem;
  }

  [data-size='roomy'] .event::before {
    left: 1rem;
    top: 2.1rem;
  }

  .event-node {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--bg);
    border: 1px solid var(--hairline-strong);
    color: var(--fg-muted);
    z-index: 1;
    transition: color 0.3s, border-color 0.3s, transform 0.35s var(--ease-out);
  }

  [data-size='roomy'] .event-node {
    width: 2rem;
    height: 2rem;
  }

  .event-node[data-kind='merge'] {
    color: #a371f7;
    border-color: color-mix(in oklab, #a371f7 40%, transparent);
  }

  .event-node[data-kind='pr'],
  .event-node[data-kind='review'] {
    color: #3fb950;
    border-color: color-mix(in oklab, #3fb950 40%, transparent);
  }

  .event-node[data-kind='issue'] {
    color: #58a6ff;
    border-color: color-mix(in oklab, #58a6ff 40%, transparent);
  }

  .event-node[data-kind='release'],
  .event-node[data-kind='repo'] {
    color: var(--accent);
    border-color: var(--accent-soft);
  }

  .event:hover .event-node {
    transform: scale(1.08);
  }

  .event-body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .event-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.74rem;
    color: var(--fg-muted);
  }

  [data-size='roomy'] .event-line {
    font-size: 0.8rem;
  }

  .event-num {
    font-family: var(--font-mono);
    color: var(--fg-faint);
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    border: 1px solid currentColor;
  }

  .pill[data-state='merged'] {
    color: #a371f7;
    background: color-mix(in oklab, #a371f7 14%, transparent);
  }

  .pill[data-state='open'] {
    color: #3fb950;
    background: color-mix(in oklab, #3fb950 14%, transparent);
  }

  .pill[data-state='closed'] {
    color: #f85149;
    background: color-mix(in oklab, #f85149 14%, transparent);
  }

  .pill[data-state='released'],
  .pill[data-state='new'],
  .pill[data-state='external'] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .event-title {
    font-size: 0.82rem;
    color: var(--fg);
    line-height: 1.35;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    transition: color 0.3s var(--ease-out);
  }

  [data-size='roomy'] .event-title {
    font-size: var(--step-0);
  }

  .event:hover .event-title {
    color: var(--accent-ink);
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-faint);
  }

  .event-branch::before {
    content: '⑂ ';
  }

  .event-when {
    margin-left: auto;
  }
</style>
