---
/**
 * Renders unfilled content from profile.ts as an obvious placeholder chip, so
 * a half-finished section can never be mistaken for a finished one.
 */
import { todoText } from '../lib/content';

interface Props {
  value: string;
}

const { value } = Astro.props;
---

<span class="todo" title="Fill this in in src/data/profile.ts">
  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
    <path d="M12 9v4M12 17h.01" stroke-linecap="round" />
    <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke-linejoin="round" />
  </svg>
  {todoText(value)}
</span>
