---
/**
 * Talks, split into public conferences and internal ones — internal talks are
 * real speaking experience and worth showing, they just need labelling so the
 * distinction is honest.
 */
import Section from './Section.astro';
import Todo from './Todo.astro';
import { talks } from '../data/profile';
import { isTodo, monthYear } from '../lib/content';

/** Newest first, with undated entries kept at the end rather than the top. */
const sorted = [...talks].sort((a, b) => {
  const aDated = !isTodo(a.date);
  const bDated = !isTodo(b.date);
  if (aDated !== bDated) return aDated ? -1 : 1;
  return a.date < b.date ? 1 : -1;
});

const externalCount = sorted.filter((talk) => talk.scope === 'external').length;
const internalCount = sorted.length - externalCount;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;

/** Every distinct city a talk was given in — the travel is part of the story. */
const cities = new Set(
  talks.flatMap((talk) => ('locations' in talk && talk.locations ? talk.locations : [])),
);
---

<Section
  id="speaking"
  index="04 / Teaching"
  title="Teaching and speaking"
  note={`${plural(externalCount, "conference talk")}, ${internalCount} internal${cities.size > 1 ? `, taught across ${cities.size} cities` : ""}.`}
>
  <div class="scope-tabs" role="tablist" aria-label="Filter talks">
    <button class="scope-tab" role="tab" data-filter="all" aria-selected="true">All</button>
    <button class="scope-tab" role="tab" data-filter="external" aria-selected="false">Conferences</button>
    <button class="scope-tab" role="tab" data-filter="internal" aria-selected="false">Internal</button>
  </div>

  <div data-stagger="70">
    {/* One dialog serves every photo on the page; the script swaps the source. */}
    <dialog class="lightbox" data-lightbox-dialog>
      <button class="lightbox-close" data-lightbox-close aria-label="Close">×</button>
      <img data-lightbox-image alt="" />
    </dialog>

    {sorted.map((talk) => (
      <article class="talk" data-scope={talk.scope} data-reveal>
        <p class="talk-when">
          {isTodo(talk.date) ? <Todo value={talk.date} /> : monthYear(talk.date)}
          {/* Scope first — conference or internal is the thing a reader wants
              to know — then the format, when it's worth distinguishing. */}
          <span class="scope-chip" data-scope={talk.scope}>
            {talk.scope === 'external' ? 'conference' : 'internal'}
          </span>
          {'format' in talk && talk.format === 'workshop' && (
            <span class="scope-chip format-chip">workshop</span>
          )}
        </p>

        <div>
          <h3 class="talk-title">
            {isTodo(talk.title) ? <Todo value={talk.title} /> : talk.title}
          </h3>
          <p class="talk-event">
            {isTodo(talk.event) ? <Todo value={talk.event} /> : talk.event}
            {!('locations' in talk) && !isTodo(talk.location) && (
              <span class="talk-place"> · {talk.location}</span>
            )}
          </p>

          {/* A series that travelled: every city it was taught in. */}
          {'locations' in talk && talk.locations && (
            <p class="cities">
              {talk.locations.map((city) => <span class="city">{city}</span>)}
            </p>
          )}
          <p class="talk-desc">
            {isTodo(talk.description) ? <Todo value={talk.description} /> : talk.description}
          </p>

          {'photos' in talk && talk.photos && talk.photos.length > 0 && (
            <div class="shots" data-stagger="90">
              {talk.photos.map((photo) => (
                <button
                  class="shot"
                  data-lightbox={photo.src}
                  data-reveal
                  aria-label={`View larger: ${photo.alt}`}
                >
                  <img
                    src={photo.src}
                    width={photo.width}
                    height={photo.height}
                    alt={photo.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
            </div>
          )}

          {(talk.video || talk.slides || ('link' in talk && talk.link)) && (
            <p class="talk-links">
              {'link' in talk && talk.link && (
                <a href={talk.link} target="_blank" rel="noopener">◆ Write-up</a>
              )}
              {talk.video && (
                <a href={talk.video} target="_blank" rel="noopener">▶ Watch</a>
              )}
              {talk.slides && (
                <a href={talk.slides} target="_blank" rel="noopener">◧ Slides</a>
              )}
            </p>
          )}
        </div>
      </article>
    ))}
  </div>
</Section>

<style>
  .scope-chip {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .scope-chip[data-scope='external'] {
    color: var(--accent);
  }

  .format-chip {
    color: var(--fg-muted);
    margin-top: 0.2rem;
  }

  .talk-place {
    color: var(--fg-faint);
  }

  .cities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.7rem;
  }

  .city {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    color: var(--fg-muted);
  }

  /* Lightbox ---------------------------------------------------------------- */

  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 60rem);
    max-height: 92vh;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(4, 5, 8, 0.86);
    backdrop-filter: blur(6px);
  }

  .lightbox img {
    width: 100%;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 12px;
  }

  .lightbox[open] {
    animation: pop 0.4s var(--ease-out);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  .lightbox-close {
    position: absolute;
    top: -2.5rem;
    right: 0;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--fg-muted);
    transition: color 0.3s;
  }

  .lightbox-close:hover {
    color: var(--accent);
  }

  /* Photos ------------------------------------------------------------------ */

  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.6rem;
    margin-top: 1.25rem;
    max-width: 34rem;
  }

  .shot {
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--bg-raised);
    transition: border-color 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Faces sit in the upper half of these frames. */
    object-position: 50% 30%;
    transition: transform 0.6s var(--ease-out), filter 0.4s var(--ease-out);
    filter: saturate(0.92);
  }

  .shot:hover {
    border-color: var(--accent-soft);
    transform: translateY(-2px);
  }

  .shot:hover img {
    transform: scale(1.04);
    filter: saturate(1.05);
  }

  .talk-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .talk-links a {
    color: var(--fg-muted);
    transition: color 0.3s var(--ease-out);
  }

  .talk-links a:hover {
    color: var(--accent);
  }
</style>
