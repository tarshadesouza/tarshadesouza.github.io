---
import { site } from '../data/profile';

const links = [
  { href: '#now', label: 'Now' },
  { href: '#work', label: 'Work' },
  { href: '#writing', label: 'Writing' },
  // The id stays #speaking so existing links and anchors keep working.
  { href: '#speaking', label: 'Teaching' },
  { href: '#mentoring', label: 'Mentoring' },
  { href: '#cv', label: 'CV' },
  { href: '#reading', label: 'Reading' },
];

---

<nav class="nav" aria-label="Primary">
  <div class="shell nav-inner">
    <a class="nav-mark" href="#top" aria-label={`${site.name} — back to top`}>
      <span class="dot" aria-hidden="true"></span>
      {/*
        The same italic serif T as the favicon, without its tile. Inline rather
        than an <img> so it takes the accent colour from the theme and costs no
        extra request. Cropped to the letterform.
      */}
      <svg class="nav-glyph" viewBox="9 13 51 35" aria-hidden="true" focusable="false">
        <g fill="var(--accent)" transform="translate(6.5 0) skewX(-11)">
          <rect x="12" y="15" width="40" height="5.5" />
          <rect x="12" y="15" width="4" height="8" />
          <rect x="48" y="15" width="4" height="8" />
          <rect x="29.5" y="15" width="5" height="31" />
          <rect x="24" y="41" width="16" height="5" />
        </g>
      </svg>
    </a>

    <div class="nav-links">
      {links.map((link) => <a class="nav-link" href={link.href}>{link.label}</a>)}
    </div>

    <button class="theme-toggle" type="button" aria-label="Switch to light theme">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</nav>
