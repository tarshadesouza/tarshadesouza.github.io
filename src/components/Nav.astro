---
import { site } from '../data/profile';

const links = [
  { href: '#now', label: 'Now' },
  { href: '#work', label: 'Work' },
  { href: '#writing', label: 'Writing' },
  // The id stays #speaking so existing links and anchors keep working.
  { href: '#speaking', label: 'Teaching' },
  { href: '#mentoring', label: 'Mentoring' },
  { href: '#cv', label: 'CV' },
  { href: '#reading', label: 'Reading' },
];

const initials = site.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<nav class="nav" aria-label="Primary">
  <div class="shell nav-inner">
    <a class="nav-mark" href="#top" aria-label={`${site.name} — back to top`}>
      <span class="dot" aria-hidden="true"></span>
      {initials}
    </a>

    <div class="nav-links">
      {links.map((link) => <a class="nav-link" href={link.href}>{link.label}</a>)}
    </div>

    <button class="theme-toggle" type="button" aria-label="Switch to light theme">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</nav>
