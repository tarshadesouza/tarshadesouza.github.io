---
/**
 * Event glyphs in the spirit of GitHub's own — a commit node, a pull-request
 * branch, a merge, an issue — so the timeline is scannable by shape before you
 * read a word of it.
 */
import type { EventKind } from '../lib/content';

interface Props {
  kind: EventKind;
}

const { kind } = Astro.props;
---

<svg
  class="event-icon"
  width="15"
  height="15"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {kind === 'commit' && (
    <>
      <path d="M2 12h6M16 12h6" />
      <circle cx="12" cy="12" r="4" />
    </>
  )}

  {(kind === 'pr' || kind === 'review') && (
    <>
      <circle cx="6" cy="6" r="2.4" />
      <circle cx="6" cy="18" r="2.4" />
      <path d="M6 8.4v7.2" />
      <circle cx="18" cy="18" r="2.4" />
      <path d="M18 15.6V9a3 3 0 0 0-3-3h-3" />
      <path d="M14.5 3.2 11.8 6l2.7 2.8" />
    </>
  )}

  {kind === 'merge' && (
    <>
      <circle cx="6" cy="6" r="2.4" />
      <circle cx="6" cy="18" r="2.4" />
      <path d="M6 8.4v7.2" />
      <circle cx="18" cy="12" r="2.4" />
      <path d="M15.6 12h-2.1A7.5 7.5 0 0 1 6 8.4" />
    </>
  )}

  {kind === 'issue' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="2.4" />
    </>
  )}

  {kind === 'release' && (
    <>
      <path d="M3 11.6V4.6A1.6 1.6 0 0 1 4.6 3h7L21 12.4 12.4 21 3 11.6Z" />
      <circle cx="7.6" cy="7.6" r="1.4" />
    </>
  )}

  {kind === 'repo' && (
    <>
      <path d="M4.5 4.5A2.5 2.5 0 0 1 7 2h13v15H7a2.5 2.5 0 0 0-2.5 2.5v-15Z" />
      <path d="M4.5 19.5A2.5 2.5 0 0 1 7 17h13v5H7a2.5 2.5 0 0 1-2.5-2.5Z" />
    </>
  )}

  {kind === 'fork' && (
    <>
      <circle cx="6" cy="5" r="2.4" />
      <circle cx="18" cy="5" r="2.4" />
      <circle cx="12" cy="19" r="2.4" />
      <path d="M6 7.4v1.6a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V7.4" />
      <path d="M12 12v4.6" />
    </>
  )}
</svg>

<style>
  .event-icon {
    flex: none;
  }
</style>
